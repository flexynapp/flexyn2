{
  "name": "Regimen",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the regimen"
    },
    "description": {
      "type": "string",
      "description": "Description of the regimen"
    },
    "exercises": {
      "type": "array",
      "description": "List of exercises in this regimen",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "target_sets": {
            "type": "number"
          },
          "target_reps": {
            "type": "number"
          },
          "muscle_group": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}