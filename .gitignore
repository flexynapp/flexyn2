# env — ignore all local env files but allow .env.example to be committed
.env
.env.*
!.env.example

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Generated per-language i18n aggregates (built by scripts/split-i18n.mjs
# via the `dev` / `build` / `build:i18n` npm scripts). Source of truth
# lives in src/lib/i18n-*.js part files; the aggregates are derived.
src/lib/i18n-langs/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.vite

# Claude Code local config and worktrees — never commit these
.claude/settings.local.json
.claude/worktrees/

# Supabase CLI local state
supabase/.temp/
