# env — ignore all local env files but allow .env.example to be committed
.env
.env.*
!.env.example

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# NOTE: src/locales/*.json are the i18n SOURCE OF TRUTH and are committed.
# (They replaced the generated src/lib/i18n-langs/ aggregates, which used
# to be ignored here. Do not re-add an ignore for the catalogs.)

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.vite

# Claude Code local config and worktrees — never commit these
.claude/settings.local.json
.claude/worktrees/

# Supabase CLI local state
supabase/.temp/
supabase/.branches/
